{
  "id": "consilium",
  "icon": "https://cdn.simpleicons.org/ollama",
  "activation": {
    "onStartup": true
  },
  "enabledByDefault": false,
  "contracts": {
    "tools": ["consilium_debate", "consilium_goal"]
  },
  "tools": [
    {
      "name": "consilium_debate",
      "optional": true
    },
    {
      "name": "consilium_goal",
      "optional": true
    }
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "defaultModels": {
        "type": "array",
        "items": { "type": "string" },
        "description": "기본 모델 이름 목록 (예: [\"qwen3:8b\", \"qwen2.5-coder\"]). ollama/ 접두사는 자동 부여."
      },
      "maxIterations": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "description": "goal 루프 기본 최대 반복 횟수"
      }
    }
  },
  "uiHints": {
    "defaultModels": {
      "label": "기본 모델",
      "help": "토론/goal에 사용할 모델 이름 목록 (예: qwen3:8b)."
    },
    "maxIterations": {
      "label": "최대 반복",
      "help": "goal 루프 기본 최대 반복 횟수 (1–50)."
    }
  }
}
